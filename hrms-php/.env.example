# WorkNest — environment configuration.
# Copy to ".env" (same folder as app/ and storage/) and fill in real values.
# Never commit .env or share it: it holds your database and SMTP passwords.

# production | local. "production" never shows error details in the browser.
APP_ENV=production
# Only honoured when APP_ENV is not production.
APP_DEBUG=false
# Public URL, no trailing slash — used in password-reset emails.
APP_URL=https://hr.example.com
APP_TIMEZONE=Asia/Kolkata

# MySQL / MariaDB (hPanel → Databases → MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_hrms
DB_USER=u123456789_hrms
DB_PASSWORD=change-me

# SMTP for password-reset emails (hPanel → Emails). Hostinger defaults:
#   MAIL_HOST=smtp.hostinger.com  MAIL_PORT=465  MAIL_ENCRYPTION=ssl
# Leave MAIL_HOST empty to disable sending (APP_ENV=local then logs the
# message to storage/logs/mail-*.log instead).
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="WorkNest"

# One-time setup: /install asks for this value before creating the first
# Super Admin. Use a long random string (16+ characters), then delete the
# line once setup is done. Leave empty if you create the admin over SSH
# (php app/cli/create_admin.php you@example.com).
SETUP_KEY=
