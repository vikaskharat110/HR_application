# Copy this file to .env before running the app (or just use the .env already
# checked in for local dev — it's pre-filled and ready to go).

# SQLite file database — zero setup, lives at prisma/dev.db.
# Swap this for a PostgreSQL connection string later if you deploy for real,
# e.g. postgresql://postgres:PASSWORD@localhost:5432/hr_attendance
# (then change `provider` in prisma/schema.prisma from "sqlite" to "postgresql").
DATABASE_URL="file:./dev.db"

# Random secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Optional — SMTP credentials for sending real "forgot password" emails.
# Leave unset for local dev: reset links are just logged to the server
# console instead of failing, so the flow still works without an inbox.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="you@example.com"
# SMTP_PASS="your-smtp-password-or-app-password"
# MAIL_FROM="Verdant HR <no-reply@example.com>"
